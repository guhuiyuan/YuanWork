{
  "permissions": {
    "allow": [
      "Bash(ls \"D:/workspace\" 2>/dev/null | head -20; echo \"---\"; ls -d \"D:/workspace\" 2>/dev/null || echo \"no workspace\")",
      "Read(//d/workspace/**)",
      "Bash(cd \"d:/prep for work/Projects/YuanWork\" && ls -la D:/yuanwork/data/ | head -20)",
      "Read(//d/yuanwork/data/**)",
      "Bash(env)",
      "Bash(cd /tmp && python -I -c \" *)",
      "Read(//d/tmp/**)",
      "Bash(cat \"C:/Users/<用户名>/AppData/Local/Temp/claude/2fd14e27aa038ce9/2f89c01d-1460-4d24-b224-48e1921e2265/tasks/bcm3fzdlm.output\" 2>/dev/null; echo \"---\"; cat \"C:/Users/<用户名>/AppData/Local/Temp/resume_cost.txt\" 2>/dev/null)",
      "Read(//c/Users/<用户名>/AppData/Local/Temp/**)",
      "Read(//d//**)",
      "Read(//c/Users/<用户名>/.yuanwork/**)",
      "Bash(./.venv/Scripts/python.exe /tmp/ywprobe/probe_jobs.py \"D:/yuanwork/data/store.db\")",
      "Bash(tasklist)",
      "Bash(netstat -ano)"
    ],
    "additionalDirectories": [
      "C:\\tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"python\" \"d:/prep for work/Projects/YuanWork/.claude/hooks/sdd_bash_allow.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"python\" \"d:/prep for work/Projects/YuanWork/.claude/hooks/sdd_bash_allow.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"python\" \"d:/prep for work/Projects/YuanWork/.claude/hooks/sdd_bash_allow.py\""
          }
        ]
      }
    ]
  }
}
