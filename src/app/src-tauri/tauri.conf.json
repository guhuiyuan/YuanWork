{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "YuanWork",
  "version": "0.1.0",
  "identifier": "com.yuanwork.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YuanWork",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local personal work assistant",
    "longDescription": "Wiki + memory engineering personal assistant for local document knowledge bases",
    "externalBin": [
      "binaries/yuanwork-backend"
    ]
  }
}
