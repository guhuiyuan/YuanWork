# =============================================================================
# YuanWork environment variables
# Copy to .env (which is gitignored) and fill in your LLM provider credentials.
# All YUANWORK_* vars are read by pydantic-settings.
# =============================================================================

# ===== LLM Providers =====
# These are referenced from configs/models.yaml via `api_key_env: <NAME>`.
# LiteLLM picks them up at gateway load time.

# MiniMax (default)
MINIMAX_API_KEY=your_minimax_api_key_here

# OpenAI (uncomment to use)
# OPENAI_API_KEY=sk-...

# Anthropic (uncomment to use)
# ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (uncomment to use)
# DEEPSEEK_API_KEY=sk-...

# Ollama (local — no key needed, just make sure ollama is running)
# OLLAMA_API_BASE=http://localhost:11434

# ===== YuanWork core =====

# Network isolation mode
#   0 — no restrictions (escape hatch for debugging)
#   1 — only allow whitelisted provider domains + localhost (DEFAULT)
#   2 — block everything including localhost; air-gapped
#
# ONLY the integer literals are accepted. The names (allow_all / llm_only /
# offline) are rejected by the validator and the process crashes on start.
YUANWORK_NETWORK_MODE=1

# Whitelist of allowed outbound domains. Must be a JSON array literal —
# a bare comma-separated string is rejected. Applies in LLM_ONLY mode.
# Localhost is always allowed in LLM_ONLY.
#
# NOTE: the embedding model is downloaded from huggingface.co, which is
# NOT in this list — the first chat or ingest will be blocked unless the
# domain is added here or the model is cached locally.
YUANWORK_ALLOWED_DOMAINS=["api.openai.com","api.anthropic.com","api.deepseek.com","api.minimaxi.com"]

# Mask phone numbers, id cards, emails and card numbers before any
# evidence is sent to the model. ON by default - the privacy promise is
# that nothing sensitive leaves the machine.
# Your own question is NOT redacted, and the citation you read still
# shows the original text: the redaction happens on the way out.
YUANWORK_ENABLE_REDACTION=true

# Data directory (default: ~/.yuanwork)
YUANWORK_DATA_DIR=./data

# ===== Embedding =====

# Local embedding model (HuggingFace id)
YUANWORK_EMBEDDING_MODEL=BAAI/bge-m3
# 1024 for bge-m3, 512 for bge-small-zh-v1.5
# YUANWORK_EMBEDDING_DIM=1024

# auto / cpu / cuda. auto = the GPU when there is one, the CPU
# otherwise — the reason for the fallback is written down by /health.
# (CUDA needs a working PyTorch CUDA build; on Windows the PyPI wheel
# is the CPU one, so a CUDA build has to be installed from the
# PyTorch index — e.g. the SJTU mirror:
#   pip install "torch==2.14.1+cu130" --index-url \
#     https://mirror.sjtu.edu.cn/pytorch-wheels/cu130)
YUANWORK_EMBEDDING_DEVICE=auto

# The embedding batch size. ZERO means "the device decides": the batch
# is cut by what the machine can hold, measured while it runs - a card
# with 6 GB and a card with 24 GB do not encode the same way, and a
# machine without a card does not either (ADR-044). Put a number here
# and it becomes a CAP: the device may go smaller on its own, never
# bigger. The slices are cut into batches of similar length, so a
# batch never mixes a one-line note with a whole page (a batch pads to
# its longest slice, so a mixed batch spends most of its work on
# padding).
YUANWORK_EMBEDDING_BATCH_SIZE=0

# bge-m3's own sparse (lexical) channel. OFF by default: the sparse
# channel of the retrieval is the full-text index (BM25), so these
# weights are only computed and stored for a possible reactivation
# some day - and on the CPU they cost a lot of every build.
YUANWORK_EMBEDDING_SPARSE_CHANNEL=false

# int8: the model's linear layers run in int8 (the weights become int8,
# the activations are quantized on the fly). On the CPU this is about
# twice as fast and the vectors move a little - so it is a setting and
# not a default. none keeps the model's own precision.
YUANWORK_EMBEDDING_QUANTIZE=none

# The cross-encoder reranker. OFF by default: it costs 568 MB of disk,
# ~1.2 GB of RAM and 5-30 s on the first use, which on a CPU-only
# machine eats the whole latency budget of the first question. Turn it
# on if you care more about the ranking than about the first answer.
YUANWORK_USE_RERANKER=false
YUANWORK_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== Document tiers =====
# How long a document has to be before the rules put it in the core
# layer on its own (ADR-031). The core layer is the documents other
# documents are read against: contracts, rules, the company's policies.
# A path with one of those words in it goes to the core layer whatever
# its size.
YUANWORK_CORE_MIN_CHARS=20000
# Below this size the model is not asked about the layer - a note is a
# note, and every question costs a call.
YUANWORK_TIER_MODEL_MIN_CHARS=8000
# How long one core document may take to compile (the model reads it
# in full and writes the pages out). The compilation runs while the
# document is being indexed - never while a question is answered. The
# ceiling is five minutes: the promise cannot be configured away.
YUANWORK_CORE_COMPILE_TIMEOUT_SECONDS=240
# How much of a core document the model reads in one go. A longer
# document is read in parts, and every conclusion says which part it
# came from.
YUANWORK_CORE_READ_CHARS=60000
# How many documents the core layer may hold. Past the ceiling the
# documents are still indexed - they are just no longer a summary of
# anything. The user's own choice is not overruled by this.
YUANWORK_CORE_MAX_DOCS=200

# ===== Bulk indexing =====
# How many slices are written to the store at once. A build of
# thousands of files is written in batches - one embedding call per
# batch instead of one per file.
YUANWORK_INDEX_BATCH_SIZE=256

# How many files are parsed at the same time. 0 = decide by the
# machine: half of the physical cores (jieba and tantivy want the CPU
# too). Raise it on a machine that is only doing a build.
YUANWORK_INGEST_WORKERS=0
# How many rows the vector store takes in one write.
YUANWORK_INDEX_WRITE_BATCH_SIZE=256
# How many slices a second may be written at most. 0 means no limit.
# The cap keeps a build from starving the rest of the machine.
YUANWORK_INDEX_RATE_LIMIT=0

# ===== Retrieval =====
# How the two recall channels are fused: alpha * dense + beta * full-text.
# The two must add up to 1.0 — the process refuses to start otherwise.
# The right split depends on the corpus: documents full of numbers and
# codes lean on the full-text channel, prose leans on the dense one.
YUANWORK_FUSION_ALPHA=0.65
YUANWORK_FUSION_BETA=0.35

# How long each step of the retrieval chain may take. The dense channel
# is the one that cannot be dropped: if it runs over its budget the
# query fails (loudly) rather than quietly returning nothing. The
# full-text channel degrades to dense-only.
YUANWORK_DENSE_TIMEOUT_SECONDS=10
YUANWORK_SPARSE_TIMEOUT_SECONDS=5
# How long a full batch of eight slices may take to embed. A bigger
# batch gets proportionally more time - the work is the same, so the
# budget grows with it.
YUANWORK_EMBEDDING_TIMEOUT_SECONDS=60

# NOT WIRED UP: the scorer keeps its own thresholds; these two only
# change the "high / medium / low" label on the score the user sees.
YUANWORK_CONFIDENCE_THRESHOLD_HIGH=0.7
YUANWORK_CONFIDENCE_THRESHOLD_LOW=0.4

# ===== Server =====

YUANWORK_HOST=127.0.0.1
YUANWORK_PORT=8765
YUANWORK_LOG_LEVEL=INFO

# Prewarm embedding model on startup (off by default; saves 1-3 min lazy load
# on first chat but adds boot time). Set to 1 to enable.
# YUANWORK_PREWARM_EMBEDDING=1

# ===== Memory / Wiki =====
# The memory engineering layer: the episodic memory (the interaction
# history), the profile store and the consolidation engine. Turn it off
# if you do not want your interaction history kept at all.
YUANWORK_ENABLE_EPISODIC_MEMORY=true

# The wiki auto-compile: pages are compiled from the evidence a chat
# surfaced.
YUANWORK_ENABLE_WIKI_AUTO_COMPILE=true

# When the consolidation may fire: after this many turns, or after this
# long without one. Both automatic triggers are live - the turn counter
# is checked after every question, the idle clock by a background
# watcher. The user can always ask for a round by hand.
YUANWORK_REFLECTION_TRIGGER_TURNS=10
YUANWORK_REFLECTION_TRIGGER_IDLE_MINUTES=30

# ===== Logging =====
# This one has NO YUANWORK_ prefix, so it is not read at all.
# Use YUANWORK_LOG_LEVEL above.
LOG_LEVEL=INFO
