# =============================================================================
# YuanWork environment variables
# Copy to .env and fill in your LLM provider credentials.
# DO NOT commit .env to version control.
# =============================================================================

# LLM Provider (MiniMax example)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

# Alternative providers (uncomment to use)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# Network isolation mode
# - allow_all: no restrictions
# - llm_only: only allow LLM API domains (default)
# - offline: completely offline (requires local model)
NETWORK_MODE=llm_only

# Embedding model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Storage paths (defaults shown)
YUANWORK_DATA_DIR=./data
YUANWORK_DB_PATH=./data/store.db
YUANWORK_LANCEDB_PATH=./data/lancedb

# Server
YUANWORK_HOST=127.0.0.1
YUANWORK_PORT=8765

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
